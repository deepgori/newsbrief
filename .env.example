# Copy to .env for local runs (or export them).
# In GitHub: Settings → Secrets and variables → Actions.

# --- Secrets ---
# Default provider: free open models on Groq (console.groq.com → API Keys)
GROQ_API_KEY=gsk_...
# Only needed if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
GMAIL_USER=yourname@gmail.com
# Google Account → Security → 2-Step Verification → App passwords (16 chars)
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Comma-separated; sent as BCC so recipients don't see each other
DIGEST_RECIPIENTS=friend@example.com,you@example.com

# --- Variables (optional) ---
# groq (default) or claude
LLM_PROVIDER=
# Defaults: groq → openai/gpt-oss-120b, claude → claude-opus-5-5
LLM_MODEL=
# Groq model used once the main one hits its daily quota (default openai/gpt-oss-20b)
GROQ_FALLBACK_MODEL=
# Linked at the bottom of the email
SITE_URL=
# Cap on articles summarised per run (default 250 on Groq, 400 on Claude)
MAX_ARTICLES_PER_RUN=
